<mxfile host="app.diagrams.net"><diagram name="Contenedores C4-2" id="c4c"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Diagrama de contenedores (C4 nivel 2) · Marketplace de Alojamientos Inversiones LR" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="60" y="0" width="1200" height="36" as="geometry"/></mxCell><mxCell id="vis" value="&lt;b style=&quot;font-size:14px&quot;&gt;Visitante&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Busca y ve alojamientos sin iniciar sesión.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=2;verticalAlign=middle;spacing=10;arcSize=18;strokeColor=#2E7D32;fontColor=#2E7D32;spacingTop=26;" vertex="1" parent="1"><mxGeometry x="125" y="122" width="170" height="118" as="geometry"/></mxCell><mxCell id="c2" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="174" y="60" width="72" height="72" as="geometry"/></mxCell><mxCell id="hue" value="&lt;b style=&quot;font-size:14px&quot;&gt;Huésped&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Cotiza, reserva, paga, cancela y reseña.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=2;verticalAlign=middle;spacing=10;arcSize=18;strokeColor=#2E7D32;fontColor=#2E7D32;spacingTop=26;" vertex="1" parent="1"><mxGeometry x="345" y="122" width="170" height="118" as="geometry"/></mxCell><mxCell id="c3" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="394" y="60" width="72" height="72" as="geometry"/></mxCell><mxCell id="anf" value="&lt;b style=&quot;font-size:14px&quot;&gt;Anfitrión&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Publica alojamientos y gestiona su calendario.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=2;verticalAlign=middle;spacing=10;arcSize=18;strokeColor=#2E7D32;fontColor=#2E7D32;spacingTop=26;" vertex="1" parent="1"><mxGeometry x="565" y="122" width="170" height="118" as="geometry"/></mxCell><mxCell id="c4" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="614" y="60" width="72" height="72" as="geometry"/></mxCell><mxCell id="adm" value="&lt;b style=&quot;font-size:14px&quot;&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Modera publicaciones, usuarios y tarifas.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=2;verticalAlign=middle;spacing=10;arcSize=18;strokeColor=#2E7D32;fontColor=#2E7D32;spacingTop=26;" vertex="1" parent="1"><mxGeometry x="785" y="122" width="170" height="118" as="geometry"/></mxCell><mxCell id="c5" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="834" y="60" width="72" height="72" as="geometry"/></mxCell><mxCell id="bnd" value="&lt;b style=&quot;font-size:14px&quot;&gt;Marketplace de Alojamientos Inversiones LR&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema de software]&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1168BD;strokeWidth=1.5;align=left;verticalAlign=bottom;spacingLeft=14;spacingBottom=8;fontColor=#1168BD;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="960" height="780" as="geometry"/></mxCell><mxCell id="spa" value="&lt;b style=&quot;font-size:14px&quot;&gt;Aplicación web&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Contenedor: React 18 + Vite, TypeScript]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Interfaz de una sola página que corre en el navegador; muestra a cada rol solo sus pantallas.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=2;verticalAlign=middle;spacing=10;strokeColor=#1168BD;fontColor=#1168BD;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="400" y="390" width="300" height="160" as="geometry"/></mxCell><mxCell id="c6" value="" style="line;strokeWidth=2;html=1;strokeColor=#1168BD;fillColor=none;" vertex="1" parent="spa"><mxGeometry x="0" y="18" width="300" height="2" as="geometry"/></mxCell><mxCell id="c7" value="" style="ellipse;html=1;fillColor=#1168BD;strokeColor=#1168BD;" vertex="1" parent="spa"><mxGeometry x="10" y="5" width="9" height="9" as="geometry"/></mxCell><mxCell id="c8" value="" style="ellipse;html=1;fillColor=#1168BD;strokeColor=#1168BD;" vertex="1" parent="spa"><mxGeometry x="24" y="5" width="9" height="9" as="geometry"/></mxCell><mxCell id="c9" value="" style="ellipse;html=1;fillColor=#1168BD;strokeColor=#1168BD;" vertex="1" parent="spa"><mxGeometry x="38" y="5" width="9" height="9" as="geometry"/></mxCell><mxCell id="api" value="&lt;b style=&quot;font-size:14px&quot;&gt;API REST&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Contenedor: Python 3.12, Django 5 + DRF, Gunicorn]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Expone los nueve servicios del negocio en /api/v1, autentica con JWT y aplica las reglas de negocio.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=2;verticalAlign=middle;spacing=10;strokeColor=#1168BD;fontColor=#1168BD;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="400" y="660" width="300" height="160" as="geometry"/></mxCell><mxCell id="c10" value="&amp;gt;_" style="text;html=1;fontStyle=1;fontSize=16;fontColor=#1168BD;align=left;verticalAlign=top;fontFamily=Courier New;" vertex="1" parent="api"><mxGeometry x="8" y="4" width="40" height="24" as="geometry"/></mxCell><mxCell id="cron" value="&lt;b style=&quot;font-size:14px&quot;&gt;Tareas programadas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Contenedor: comando de Django por cron]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Cada hora pasa a COMPLETADA las reservas terminadas y depura cotizaciones vencidas.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=2;verticalAlign=middle;spacing=10;strokeColor=#1168BD;fontColor=#1168BD;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="100" y="660" width="230" height="160" as="geometry"/></mxCell><mxCell id="c11" value="&amp;gt;_" style="text;html=1;fontStyle=1;fontSize=16;fontColor=#1168BD;align=left;verticalAlign=top;fontFamily=Courier New;" vertex="1" parent="cron"><mxGeometry x="8" y="4" width="40" height="24" as="geometry"/></mxCell><mxCell id="db" value="&lt;b style=&quot;font-size:14px&quot;&gt;Base de datos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Contenedor: PostgreSQL 16]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;24 tablas: usuarios, publicaciones, reservas, pagos, reseñas, notificaciones y auditoría.&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1168BD;fontColor=#1168BD;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="400" y="910" width="300" height="150" as="geometry"/></mxCell><mxCell id="stripe" value="&lt;b style=&quot;fo