FF;strokeWidth=2;spacing=8;strokeColor=#1168BD;fontColor=#1168BD;spacingLeft=8;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1005.0" y="80.0" width="250.0" height="140.0" as="geometry"/></mxCell><mxCell id="v6" value="" style="line;strokeWidth=2;html=1;strokeColor=#1168BD;fillColor=none;" vertex="1" parent="spa"><mxGeometry x="0.0" y="16.0" width="250.0" height="2.0" as="geometry"/></mxCell><mxCell id="v7" value="" style="ellipse;html=1;fillColor=#1168BD;strokeColor=#1168BD;" vertex="1" parent="spa"><mxGeometry x="8.0" y="4.0" width="8.0" height="8.0" as="geometry"/></mxCell><mxCell id="v8" value="" style="ellipse;html=1;fillColor=#1168BD;strokeColor=#1168BD;" vertex="1" parent="spa"><mxGeometry x="20.0" y="4.0" width="8.0" height="8.0" as="geometry"/></mxCell><mxCell id="v9" value="" style="ellipse;html=1;fillColor=#1168BD;strokeColor=#1168BD;" vertex="1" parent="spa"><mxGeometry x="32.0" y="4.0" width="8.0" height="8.0" as="geometry"/></mxCell><mxCell id="auth" value="&lt;b style=&quot;font-size:13px&quot;&gt;Autenticación y permisos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: SimpleJWT + permisos de DRF]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Valida el token, el rol y el estado de la cuenta antes de entregar la petición a un servicio.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=2;spacing=8;strokeColor=#1168BD;fontColor=#1168BD;spacingLeft=22;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="520.0" y="360.0" width="1220.0" height="90.0" as="geometry"/></mxCell><mxCell id="v11" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#1168BD;strokeWidth=1.5;" vertex="1" parent="auth"><mxGeometry x="-9.0" y="12.0" width="18.0" height="9.0" as="geometry"/></mxCell><mxCell id="v12" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#1168BD;strokeWidth=1.5;" vertex="1" parent="auth"><mxGeometry x="-9.0" y="27.0" width="18.0" height="9