# Ruta base de la API. Es relativa porque el front y la API comparten origen:
# en desarrollo por el proxy de Vite (vite.config.ts) y en Render por la regla /api/*.
VITE_API_URL=/api/v1
# Llave PUBLICABLE de Stripe en modo prueba (empieza por pk_test_). Si queda vacía se usa el pago simulado.
# Va solo en frontend/.env o en las variables de Render; nunca en el repositorio.
VITE_STRIPE_PUBLIC_KEY=
