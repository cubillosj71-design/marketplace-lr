# Copia este archivo como .env y ajusta los valores. Nunca subas el .env al repositorio.
DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://marketplace:marketplace@localhost:5432/marketplace_db
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Llave SECRETA de Stripe en modo prueba (empieza por sk_test_). Si queda vacía se usa el pago simulado.
# Va solo en backend/.env o en las variables de Render; nunca en el repositorio.
STRIPE_SECRET_KEY=
# Token de las tareas programadas (encabezado X-Token-Tareas). Genera uno largo y aleatorio; va solo en .env,
# en Render y en los secretos de GitHub (TOKEN_TAREAS), nunca en el repositorio.
TOKEN_TAREAS=
# Correo para recuperar la contraseña (Gmail). Usa una cuenta del equipo con verificación en dos pasos y crea una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords (16 caracteres). Va solo en .env y en
# Render, nunca en el repositorio. Si EMAIL_HOST_USER queda vacío, en desarrollo el correo se imprime en la terminal.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Dirección de la aplicación web que va en el enlace del correo (en Render, la URL pública del frontend)
FRONTEND_URL=http://localhost:5173
