# Copia este archivo como .env y ajusta los valores. Nunca subas el .env al repositorio.
DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://marketplace:marketplace@localhost:5432/marketplace_db
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Llave SECRETA de Stripe en modo prueba (empieza por sk_test_). Si queda vacía se usa el pago simulado.
# Va solo en backend/.env o en las variables de Render; nunca en el repositorio.
STRIPE_SECRET_KEY=
