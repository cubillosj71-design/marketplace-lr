[importlinter]
root_packages =
    apps
    config
include_external_packages = False

[importlinter:contract:identidad]
name = identidad no importa modelos de otros servicios (ADR-001)
type = forbidden
source_modules =
    apps.identidad
forbidden_modules =
    apps.catalogo.models
    apps.busqueda.models
    apps.reservas.models
    apps.pagos.models
    apps.resenas.models
    apps.notificaciones.models
    apps.auditoria.models
    apps.reportes.models

