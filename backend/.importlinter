[importlinter]
root_packages =
    apps
    config
include_external_packages = False

# Cada contrato prohíbe que un servicio importe DIRECTAMENTE los modelos de otro.
# allow_indirect_imports = True permite la cadena  A -> B.services -> B.models,
# que es justamente la forma correcta de comunicarse (ADR-001): A usa la interfaz
# pública de B, y B, por dentro, usa sus propios modelos. Sin esta opción
# import-linter rechaza también esa cadena y ningún servicio podría llamar a otro.

[importlinter:contract:identidad]
name = identidad no importa modelos de otros servicios (ADR-001)
type = forbidden
allow_indirect_imports = True
source_modules =
    apps.identidad
forbidden_modules =
    apps.catalogo.models
    apps.busqueda.models
    apps.reservas.models
    apps.pagos.models
    apps.resenas.models
    apps.notificaciones.models
    apps.auditoria.models
    apps.reportes.models

