# Dependencias síncronas en un solo sentido (sección 3.3 del diseño)
[importlinter:contract:catalogo-no-depende-de-reservas]
name = Catálogo no depende de Reservas (sección 3.3)
type = forbidden
allow_indirect_imports = True
source_modules =
    apps.catalogo
forbidden_modules =
    apps.reservas
# Las pruebas de integración sí pueden revisar el efecto en Reservas
ignore_imports =
    apps.catalogo.tests.** -> apps.reservas.**

[importlinter:contract:identidad-solo-usa-reservas]
name = Identidad solo consulta a Reservas (sección 3.3)
type = forbidden
allow_indirect_imports = True
source_modules =
    apps.identidad
forbidden_modules =
    apps.catalogo
    apps.busqueda
    apps.reportes
